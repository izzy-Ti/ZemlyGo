# ZemlyGo Environment Variables

# Server Port
PORT=8080

# Environment: development | production
ENV=development

# Database Connection (Neon Serverless PostgreSQL)
# Copy from https://console.neon.tech (use pooled connection endpoint)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth Configuration
# Neon Authorize / Better Auth JWKS endpoint URL (e.g. https://<project>.neon.tech/.well-known/jwks.json)
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=

# JWT Signing Secret (for HMAC tokens and local testing)
JWT_SECRET=zemlygo-super-secret-production-jwt-key-2026

# Map & Routing Configuration (osrm is free and requires no key)
MAPS_PROVIDER=osrm
MAPS_API_KEY=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*
